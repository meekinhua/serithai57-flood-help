MONGO_URL=mongodb://localhost:27017
DB_NAME=app_database
# First admin, created on startup if missing (idempotent)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=ผู้ดูแลหมู่บ้าน
# Secret admin link: <site>/admin#key=<ADMIN_URL_KEY> (at least 16 chars)
ADMIN_URL_KEY=change-me-to-a-long-random-string
# Weather sources in order of preference (open-meteo, met-norway). Open-Meteo free tier has a daily
# per-IP quota that other tenants on a shared hosting IP can use up; MET Norway does not.
WEATHER_PROVIDERS=open-meteo,met-norway
